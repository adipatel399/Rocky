#!/bin/zsh
# ROCKY launcher — the server lives and dies with this terminal.
#   rocky           → start the server in THIS terminal + open the window
#                      (close the terminal or Ctrl+C to power him down)
#   rocky stop      → shut down a running server from anywhere
#   rocky logs      → tail the server log

DIR="$(cd "$(dirname "$0")/.." && pwd)"   # project root (bin/..)
URL="http://localhost:8765"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

server_matches_project() {
  curl -fsS --max-time 2 "$URL/api/stats" 2>/dev/null | "$DIR/.venv/bin/python" -c '
import json, os, sys
try:
    info = json.load(sys.stdin)
    expected = os.path.realpath(sys.argv[1])
    valid = info.get("app") == "rocky" and os.path.realpath(info.get("project_root", "")) == expected
except (ValueError, OSError):
    valid = False
sys.exit(0 if valid else 1)
' "$DIR"
}

open_window() {
  if [[ -x "$CHROME" ]]; then
    open -na "Google Chrome" --args --app="$URL" --window-size=1500,920
  else
    open "$URL"
  fi
}

case "$1" in
  stop)
    PID=$(lsof -ti :8765 -sTCP:LISTEN)
    if [[ -n "$PID" ]]; then
      if ! server_matches_project; then
        echo "Port 8765 belongs to another or outdated app. Stop that copy from its own terminal first."
        exit 1
      fi
      kill $PID && echo "ROCKY powered down."
    else
      echo "ROCKY wasn't running."
    fi
    exit 0 ;;
  logs)
    exec tail -f "$DIR/data/rocky.log" ;;
esac

# Already awake? Just bring up the window.
if server_matches_project; then
  echo "ROCKY is already awake — opening his window."
  open_window
  exit 0
fi

if lsof -ti :8765 -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Another app or outdated Rocky copy is using port 8765."
  echo "Stop it from its own terminal, then run this launcher again: $DIR/bin/rocky"
  exit 1
fi

cd "$DIR" || exit 1
mkdir -p data

# Open the window as soon as the server answers.
( for i in {1..60}; do
    server_matches_project && { open_window; exit 0; }
    sleep 0.5
  done ) &

echo "ROCKY online. This terminal is his lifeline — close it (or Ctrl+C) to power him down."
.venv/bin/python -m rocky 2>&1 | tee -a data/rocky.log
